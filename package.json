{
  "name": "kasira-landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing and sales website for Kasira, a POS / cashier application for Indonesian businesses.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-static-export.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "preview": "serve out -l 4173 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run deploy:check"
  },
  "dependencies": {
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "overrides": {
    "compression": "1.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
