# URL publik situs. Dipakai saat build untuk canonical, Open Graph, sitemap,
# robots, dan metadataBase.
#
# Salin file ini menjadi .env.local untuk pengembangan, atau isi sebagai
# Build Variable di Cloudflare Workers Builds:
#   Settings > Build > Build Variables and Secrets
#
# Contoh:
# NEXT_PUBLIC_SITE_URL=https://kasirapp.username.workers.dev
# NEXT_PUBLIC_SITE_URL=https://domainanda.com
#
# Biarkan kosong untuk memakai fallback https://example.com (placeholder).
NEXT_PUBLIC_SITE_URL=
